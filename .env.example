# Instagram Session ID
# Obtain this from Instagram by logging in and checking browser cookies
INSTAGRAM_SESSION_ID=

# Visual AI Configuration (Ollama)
VISUAL_AI_ROUTE=http://localhost:11434/api/generate
VISUAL_AI_MODEL=llava

# Processing Settings
OUTPUT_DIR=./dataset
MAX_IMAGES=1000
RATE_LIMIT_DELAY=1
IMAGE_QUALITY=90
TARGET_SIZE_MB=5

# Caption Generation
GENERATE_CAPTIONS=true
CAPTION_PAIRS_FORMAT=json

# Image Filtering
FILTERING_ENABLED=true
MIN_CONFIDENCE=0.7
FILTERING_PROMPT="Keep only images of beautifull backgounds and nature, exclude people. (This is an example guideline that will be used to filter out images, edit it before use)"
