# Instagram Session ID
# Obtain this from Instagram by logging in and checking browser cookies
INSTAGRAM_SESSION_ID=

# Visual AI Configuration
# Engine: ollama (default), llama.cpp or strata  (can be overridden with --engine)
VISUAL_AI_TYPE=ollama

# Ollama settings
VISUAL_AI_OLLAMA_HOST=http://localhost:11434
VISUAL_AI_OLLAMA_MODEL=llava
# Only if Ollama sits behind an authenticating proxy
VISUAL_AI_OLLAMA_API_KEY=

# llama.cpp settings (llama-server, OpenAI-compatible)
VISUAL_AI_LLAMA_HOST=http://localhost:8080
VISUAL_AI_LLAMA_MODEL=gemma4
# The key given to llama-server --api-key
VISUAL_AI_LLAMA_API_KEY=

# Strata settings (OpenAI-compatible, serves Qwen3.8 quantized)
# NOTE: Strata and llama.cpp both default to port 8080 - don't run both at once
VISUAL_AI_STRATA_HOST=http://127.0.0.1:8080
VISUAL_AI_STRATA_MODEL=qwen3.8-flash-next
VISUAL_AI_STRATA_API_KEY=

# Processing Settings
OUTPUT_DIR=./dataset
MAX_IMAGES=1000
RATE_LIMIT_DELAY=1
IMAGE_QUALITY=90
TARGET_SIZE_MB=5

# Caption Generation
GENERATE_CAPTIONS=true
CAPTION_PAIRS_FORMAT=json

# Image Filtering
FILTERING_ENABLED=true
MIN_CONFIDENCE=0.7
FILTERING_PROMPT="Keep only images of beautifull backgounds and nature, exclude people. (This is an example guideline that will be used to filter out images, edit it before use)"
